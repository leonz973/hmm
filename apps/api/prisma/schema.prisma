// HMM 数据模型（Prisma schema）
// 金额一律 Int 存"分"；日期存 LocalDate 字符串（YYYY-MM-DD）避免时区歧义。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   Membership[]
  ownedHouses   Household[]    @relation("HouseholdOwner")
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
}

model Household {
  id          String    @id @default(cuid())
  name        String
  ownerUserId String
  inviteCode  String?   @unique
  inviteExp   DateTime?
  warrantyLeadDays Int @default(60)
  replaceLeadDays  Int @default(90)
  notifyEmail      Boolean @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  owner          User            @relation("HouseholdOwner", fields: [ownerUserId], references: [id])
  memberships    Membership[]
  categories     Category[]
  locations      Location[]
  assets         Asset[]
  fixedExpenses  FixedExpense[]
  expenseRecords ExpenseRecord[]
  utilityBills   UtilityBill[]
  invoices       Invoice[]
  invoiceAssets  InvoiceAsset[]
  reminders      Reminder[]
  reminderRuns   ReminderRunLog[]
  auditLogs      AuditLog[]
  attachments    Attachment[]
  maintenancePlans MaintenancePlan[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  householdId String
  role        String // owner | member
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@unique([userId, householdId])
  savingGoals         SavingGoal[]
  insurancePolicies   InsurancePolicy[]
}

model Category {
  id                    String  @id @default(cuid())
  householdId           String? // null = 内置全局品类（只读种子）
  parentId              String?
  key                   String? // 内置品类的稳定 key
  name                  String
  icon                  String?
  defaultLifeMonths     Int?
  defaultWarrantyMonths Int?
  inflationRate         Float? // 年通胀率 %（SQLite 用 Float）
  isBuiltin             Boolean @default(false)

  household Household? @relation(fields: [householdId], references: [id])
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  assets    Asset[]

  @@unique([householdId, key])
}

model Location {
  id          String @id @default(cuid())
  householdId String
  name        String

  household Household @relation(fields: [householdId], references: [id])
  assets    Asset[]
}

model Asset {
  id                      String    @id @default(cuid())
  householdId             String
  name                    String
  categoryId              String?
  categoryKey             String? // 内置品类 key（前端选择用）
  categoryName            String? // 冗余存名字，品类改名不影响历史记录
  warrantyMonths          Int? // 质保月数（录入时确认下来的值）
  expectedLifeMonths      Int? // 预计寿命月数（含使用强度前的原始值）
  note                    String?
  brand                   String?
  model                   String?
  sn                      String?
  purchaseDate            String? // YYYY-MM-DD
  priceFen                Int? // 购买价（分）
  qty                     Int       @default(1)
  locationId              String?
  locationName            String? // 房间名字（如「厨房」），先存文本，后续可归到 Location 表
  status                  String    @default("in_use") // in_use|replaced|scrapped|donated|sold
  usageLevel              String? // low|mid|high
  expectedReplacementDate String? // YYYY-MM-DD（推算结果，可手改）
  estReplacementPriceFen  Int? // 预估更换价（分）
  replacedByAssetId       String?
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  household     Household      @relation(fields: [householdId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])
  warranties    Warranty[]
  invoiceAssets InvoiceAsset[]
  maintenancePlans MaintenancePlan[]
}

model MaintenancePlan {
  id             String    @id @default(cuid())
  householdId    String
  assetId        String
  title          String // 清洗滤网 / 换滤芯 / 检修
  intervalMonths Int // 周期（月）
  lastDoneDate   String? // 上次完成 YYYY-MM-DD
  nextDueDate    String // 下次到期 YYYY-MM-DD
  note           String?
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([assetId])
}

model Warranty {
  id        String   @id @default(cuid())
  assetId   String
  type      String // manufacturer|extended|seller
  startDate String // YYYY-MM-DD
  endDate   String // YYYY-MM-DD
  provider  String?
  invoiceId String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id])
}

model FixedExpense {
  id          String    @id @default(cuid())
  householdId String
  name        String
  amountFen   Int
  cycle       String // 每月|每季|每半年|每年
  customDays  Int?
  dueDate     String // YYYY-MM-DD 首次扣款日
  category    String?
  note        String?
  account     String?
  autoPay     Boolean   @default(false)
  active      Boolean   @default(true)
  endDate     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  household      Household       @relation(fields: [householdId], references: [id])
  expenseRecords ExpenseRecord[]
}

model ExpenseRecord {
  id          String   @id @default(cuid())
  householdId String
  date        String // YYYY-MM-DD
  amountFen   Int
  note        String?
  refType     String // fixed|utility|manual
  refId       String?
  createdBy   String
  createdAt   DateTime @default(now())

  household Household     @relation(fields: [householdId], references: [id])
  fixedRef  FixedExpense? @relation(fields: [refId], references: [id])
}

model UtilityBill {
  id          String    @id @default(cuid())
  householdId String
  type        String // 水费|电费|燃气费|物业费|其他
  period      String? // YYYY-MM
  periodStart String?
  periodEnd   String?
  dueDate     String?
  paidDate    String?
  amountFen   Int
  usage       String?
  reading     String?
  invoiceId   String?
  note        String?
  createdBy   String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  household Household @relation(fields: [householdId], references: [id])
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id          String    @id @default(cuid())
  householdId String
  files       String    @default("[]") // JSON 字符串：[{name,type,size,key}]
  title       String?
  kind        String?
  amountFen   Int?
  invoiceDate String?
  merchant    String?
  invoiceNo   String?
  note        String?
  reimbursed  Boolean?
  createdBy   String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  household    Household      @relation(fields: [householdId], references: [id])
  utilityBills UtilityBill[]
  assets       InvoiceAsset[]
}

model InvoiceAsset {
  invoiceId String
  assetId   String

  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  asset       Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id])
  householdId String?

  @@id([invoiceId, assetId])
}

model Attachment {
  id          String   @id @default(cuid())
  householdId String
  objectKey   String
  mime        String
  size        Int
  entity      String // asset|invoice|bill
  entityId    String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
}

model Reminder {
  id          String    @id @default(cuid())
  householdId String
  type        String // warranty_expire|replacement|fixed_due|subscription
  refId       String
  fireDate    String // YYYY-MM-DD
  severity    String    @default("info") // info|warn|urgent
  payload     String? // JSON 字符串
  readAt      DateTime?
  sentPushAt  DateTime?
  sentEmailAt DateTime?
  emailTo     String?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id])

  @@unique([type, refId, fireDate])
}

model ReminderRunLog {
  id          String   @id @default(cuid())
  householdId String
  runDate     String // YYYY-MM-DD
  trigger     String // cron|manual
  found       Int      @default(0)
  created     Int      @default(0)
  sent        Int      @default(0)
  status      String   @default("ok") // ok|skipped|failed
  message     String?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])

  @@index([householdId, runDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  action      String
  entity      String
  entityId    String?
  detail      String? // JSON 字符串
  at          DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

/// 刷新令牌（只存哈希，可撤销）
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SavingGoal {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name          String
  targetFen     Int
  savedFen      Int       @default(0)
  targetDate    String
  linkedAssetId String?
  note          String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([householdId])
}

model InsurancePolicy {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  kind        String
  company     String?
  coverageFen Int       @default(0)
  premiumFen  Int       @default(0)
  cycle       String    @default("每年")
  startDate   String
  endDate     String
  contact     String?
  note        String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([householdId])
}
