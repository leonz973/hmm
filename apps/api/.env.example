# ── 服务端（API）环境变量模板 ──
# 复制为 .env 后填写；.env 已在 .gitignore 里，绝不提交

NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai

# SQLite 数据库文件（相对 apps/api 目录；镜像里是 file:/data/hmm.db）
DATABASE_URL="file:./dev.db"

# JWT（生产必须换成随机 64 位以上字符串：openssl rand -hex 32）
JWT_SECRET="dev-only-change-me-please-0123456789abcdef0123456789abcdef"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 附件落盘目录（留空 = <仓库>/storage）
STORAGE_DIR=

# SMTP（QQ/163 个人邮箱：密码填"授权码"，不是登录密码；不配则邮件写到预览文件）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM="HMM 家庭资产管家 <your@qq.com>"

# 站点地址（邮件里的链接用）
APP_URL=http://localhost:5173

# 没配 SMTP 时邮件预览写到这个目录（默认 <仓库>/.mail-out）
MAIL_PREVIEW_DIR=
