# ── 服务端（API）环境变量模板 ──
# 复制为 .env 后填写；绝不提交 .env

NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai

# PostgreSQL
DATABASE_URL="postgresql://hmm:hmm_dev_pw@localhost:5432/hmm?schema=public"

# JWT（生产必须替换为随机 64 位以上字符串）
JWT_SECRET="dev-only-change-me-please-0123456789abcdef0123456789abcdef"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=hmm_minio
MINIO_SECRET_KEY=hmm_minio_dev_pw
MINIO_BUCKET=hmm-attachments

# SMTP（QQ/163 个人邮箱：密码填"授权码"，不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM="HMM 家庭资产管家 <your@qq.com>"

# 站点地址（用于邮件里的验证/重置链接）
APP_URL=http://localhost:5173

# 附件落盘目录（默认 <仓库>/storage）
STORAGE_DIR=
# 没配 SMTP 时邮件预览写到这个目录（默认 <仓库>/.mail-out）
MAIL_PREVIEW_DIR=
