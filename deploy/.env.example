# HMM 生产环境变量模板
# cp .env.example .env 后填写真实值；.env 不得提交

# 有域名填域名（如 hmm.example.com，自动签发 HTTPS）
# 无域名填 :80，用 http://服务器IP 访问
DOMAIN=:80

TZ=Asia/Shanghai

POSTGRES_USER=hmm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hmm

JWT_SECRET=change-me-random-64-chars-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

MINIO_ROOT_USER=hmm_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=hmm-attachments

# QQ 邮箱：smtp.qq.com / 465 / 授权码；163：smtp.163.com / 465 / 授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM="HMM 家庭资产管家 <your@qq.com>"

APP_URL=http://your-server-ip
