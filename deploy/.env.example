# HMM 生产环境变量模板
# cp .env.example .env 后填写真实值；.env 不得提交（已在 .gitignore 里）

# 有域名填域名（如 hmm.example.com，Caddy 自动签发 HTTPS）
# 没有域名就留 :80，用 http://服务器IP 访问
DOMAIN=:80

# 必须改：随机 64 位以上，可用 `openssl rand -hex 32` 生成
JWT_SECRET=change-me-random-64-chars-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 前端用到的公开地址（写进邮件里的链接）
APP_URL=http://your-server-ip

# 发信邮箱（QQ：smtp.qq.com:465；163：smtp.163.com:465；密码填「授权码」不是登录密码）
# 留空则不发邮件，提醒只会写进 .mail-out 预览文件
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=HMM 家庭资产管家 <your@qq.com>
